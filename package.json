{
  "name": "vaylakaverit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @vaylakaverit/web dev",
    "dev:api": "pnpm --filter @vaylakaverit/api dev",
    "preview": "bash scripts/with-node22.sh pnpm --parallel --filter @vaylakaverit/api --filter @vaylakaverit/web dev",
    "e2e": "bash scripts/with-node22.sh playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "spec:new": "./scripts/openspec-new-change.sh",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "harness:test": "bash scripts/__tests__/run-all.sh",
    "check": "pnpm format:check && pnpm harness:test && pnpm spec:validate && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.1.1",
    "@playwright/test": "^1.62.1",
    "husky": "^9.1.0",
    "prettier": "^3.3.3"
  }
}
